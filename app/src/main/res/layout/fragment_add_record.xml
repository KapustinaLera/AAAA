<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="64dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить запись"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- УРОВЕНЬ ТЯГИ (ПОЛЗУНОК) -->
        <TextView
            android:id="@+id/tvCravingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уровень тяги: 5/10"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
        <SeekBar
            android:id="@+id/sbCravingLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4"
            android:layout_marginBottom="16dp" />

        <!-- БЛОК ДЛЯ СИГАРЕТ -->
        <LinearLayout
            android:id="@+id/layoutSmoking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выкурено сигарет (шт.)"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
            <EditText
                android:id="@+id/etSmokedAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Кол-во штук"
                android:inputType="number" />
        </LinearLayout>

        <!-- БЛОК ДЛЯ АЛКОГОЛЯ -->
        <LinearLayout
            android:id="@+id/layoutAlcohol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выпито алкоголя (мл)"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
            <EditText
                android:id="@+id/etAlcoholAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Кол-во мл"
                android:inputType="number" />
        </LinearLayout>

        <!-- ПОТРАЧЕНО ДЕНЕГ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сколько денег реально потратили?"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
        <EditText
            android:id="@+id/etMoneySpent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Например, 300 (за пачку) или 0"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <!-- САМОЧУВСТВИЕ (ПОЛЗУНОК) -->
        <TextView
            android:id="@+id/tvWellBeingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Самочувствие: 5/10"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
        <SeekBar
            android:id="@+id/sbWellBeing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4"
            android:layout_marginBottom="16dp" />

        <!-- НАСТРОЕНИЕ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Настроение"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/etMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Как вы себя чувствуете?"
            android:inputType="text" />

        <!-- КАЧЕСТВО СНА (ПОЛЗУНОК) -->
        <TextView
            android:id="@+id/tvSleepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Качество сна: 5/10"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
        <SeekBar
            android:id="@+id/sbSleepQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="9"
            android:progress="4"
            android:layout_marginBottom="16dp" />

        <!-- ФИЗАКТИВНОСТЬ -->
        <CheckBox
            android:id="@+id/cbPhysicalActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Была физическая активность"
            android:layout_marginTop="16dp" />

        <!-- ЗАМЕТКИ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Заметки"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ваши заметки"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginTop="16dp"
            android:background="#EEEEEE"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnPickGallery"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Галерея" />

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Камера"
                android:layout_marginStart="8dp"/>
        </LinearLayout>


        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить запись"
            android:layout_marginTop="24dp"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>