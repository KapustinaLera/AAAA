<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Привет!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp" />

    <!-- Блок знакомства (показывается, если имени нет) -->
    <LinearLayout
        android:id="@+id/layoutNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Давай познакомимся! Как тебя зовут?"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etUserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Введите ваше имя"
            android:inputType="textPersonName"
            android:maxLength="20" />

        <Button
            android:id="@+id/btnSaveName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Начать!" />
    </LinearLayout>

    <!-- Блок статистики (показывается, если имя есть) -->
    <LinearLayout
        android:id="@+id/layoutStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvGreeting">

        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="«Ты сильнее, чем кажется. Не сдавайся!»"
            android:textSize="18sp"
            android:textStyle="italic"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvDaysWithout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Дней без привычки: 0"
            android:textSize="20sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMoneySaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сэкономлено: 0 руб."
            android:textSize="20sp"
            android:textColor="#4CAF50"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>